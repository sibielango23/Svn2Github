<UserControl x:Class="SVN2GitHub.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Monitor your SVN to GitHub migration progress"
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           Opacity="0.7"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshAsyncCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Refresh">
                <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
            </Button>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Migrations -->
            <materialDesign:Card Grid.Column="0"
                                 Padding="24"
                                 Margin="0,0,8,0"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="Database"
                                            Width="32"
                                            Height="32"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalMigrations}"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"/>
                    <TextBlock Text="Total"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Active Migrations -->
            <materialDesign:Card Grid.Column="1"
                                 Padding="24"
                                 Margin="4,0"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ProgressClock"
                                            Width="32"
                                            Height="32"
                                            Foreground="#3B6DFF"
                                            Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ActiveMigrations}"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"/>
                    <TextBlock Text="Active"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Completed Migrations -->
            <materialDesign:Card Grid.Column="2"
                                 Padding="24"
                                 Margin="4,0"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CheckCircle"
                                            Width="32"
                                            Height="32"
                                            Foreground="#6EE7B7"
                                            Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CompletedMigrations}"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"/>
                    <TextBlock Text="Completed"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Failed Migrations -->
            <materialDesign:Card Grid.Column="3"
                                 Padding="24"
                                 Margin="8,0,0,0"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircle"
                                            Width="32"
                                            Height="32"
                                            Foreground="#EF4444"
                                            Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FailedMigrations}"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"/>
                    <TextBlock Text="Failed"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Recent Migrations List -->
        <materialDesign:Card Grid.Row="2"
                             Padding="24"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Recent Migrations"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentMigrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                       BorderThickness="0,0,0,1"
                                       Padding="0,12"
                                       Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}">
                                                <Run Text="{Binding GithubOrg}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding GithubRepo}" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SvnUrl}"
                                                      Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                      Opacity="0.7"
                                                      Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding CurrentStep}"
                                                      Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                      Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="16,0">
                                            <ProgressBar Value="{Binding Progress}"
                                                        Width="100"
                                                        Height="4"
                                                        Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                      Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                               Command="{Binding DataContext.ViewMigrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignOutlinedButton}"
                                               Content="VIEW"
                                               Height="32"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>

        <!-- Status Bar -->
        <materialDesign:Card Grid.Row="3"
                             Padding="12,8"
                             Margin="0,16,0,0"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                        Kind="Information"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="2"
                            Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Width="16"
                            Height="16"
                            IsIndeterminate="True"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
