<Window x:Class="SVN2GitHub.Views.ResumeMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Resume migration"
        Width="540"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Resume migration"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="DestinationText"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="CheckpointText"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Opacity="0.8"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1F0288D1"
                CornerRadius="6"
                Padding="12"
                Margin="0,18,0,12">
            <TextBlock Text="Resume repeats the current incomplete stage. A long SVN import that was interrupted before completion must be run again. Completed stages are reused; a failed push resumes at push without re-importing the SVN history."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="GitHub token"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold"/>
            <PasswordBox x:Name="GithubTokenBox"
                         materialDesign:HintAssist.Hint="Enter a token with access to the destination repository"/>
            <TextBlock Text="The token is sent to the loopback API and kept in memory for the migration; it is never saved in migration history."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.72"
                       Margin="0,7,0,0"/>
            <TextBlock x:Name="StatusText"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="CANCEL"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"/>
            <Button Content="RESUME"
                    IsDefault="True"
                    Click="ResumeButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
