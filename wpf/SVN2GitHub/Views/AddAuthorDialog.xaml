<Window x:Class="SVN2GitHub.Views.AddAuthorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Author"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Add Author Mapping"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   Margin="0,0,0,24"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBox x:Name="SvnUsernameBox"
                     materialDesign:HintAssist.Hint="SVN Username *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontFamily="Consolas"
                     Margin="0,0,0,16"/>

            <TextBox x:Name="GitNameBox"
                     materialDesign:HintAssist.Hint="Git Name *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.HelperText="e.g., John Doe"
                     Margin="0,0,0,16"/>

            <TextBox x:Name="GitEmailBox"
                     materialDesign:HintAssist.Hint="Git Email *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontFamily="Consolas"
                     materialDesign:HintAssist.HelperText="e.g., john.doe@example.com"
                     Margin="0,0,0,16"/>

            <Border Background="{DynamicResource MaterialDesignDivider}"
                    Padding="12"
                    CornerRadius="4"
                    Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Example Mapping:"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <TextBlock FontFamily="Consolas"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              Text="jdoe = John Doe &lt;john.doe@company.com&gt;"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Margin="0,24,0,0">
            <Button x:Name="CancelButton"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="Cancel"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="AddButton"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Add Author"
                    Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
