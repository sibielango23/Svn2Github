<Window x:Class="SVN2GitHub.Views.AuthorMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Author Mapping"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="DataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="RowHeight" Value="48"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                Text="Author Mapping"
                Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                Margin="0,0,0,8"/>
            <TextBlock
                Text="Review and edit the SVN username to Git author mappings. The system auto-generated these based on SVN commit history."
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Toolbar -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         materialDesign:HintAssist.Hint="Search authors..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,16,0"
                         TextChanged="SearchBox_TextChanged"/>

                <!-- Load Button -->
                <Button x:Name="LoadAuthorsButton"
                        Grid.Column="1"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Load From SVN"
                        Margin="0,0,8,0"
                        Click="LoadAuthors_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Extract authors from SVN repository"/>
                    </Button.ToolTip>
                </Button>

                <!-- Add Button -->
                <Button x:Name="AddAuthorButton"
                        Grid.Column="2"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Add Author"
                        Margin="0,0,8,0"
                        Click="AddAuthor_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Manually add a new author mapping"/>
                    </Button.ToolTip>
                </Button>

                <!-- Stats -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Account"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="AuthorCountText"
                              Text="0 authors"
                              VerticalAlignment="Center"
                              FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Authors DataGrid -->
        <materialDesign:Card Grid.Row="2" Padding="0">
            <Grid>
                <DataGrid x:Name="AuthorsDataGrid"
                          Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Authors}"
                          CellEditEnding="AuthorsDataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <!-- SVN Username (Read-only) -->
                        <DataGridTextColumn
                            Header="SVN Username"
                            Binding="{Binding SvnUsername}"
                            Width="200"
                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Git Name (Editable) -->
                        <DataGridTextColumn
                            Header="Git Name"
                            Binding="{Binding GitName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="250"
                            IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Git Email (Editable) -->
                        <DataGridTextColumn
                            Header="Git Email"
                            Binding="{Binding GitEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"
                            IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Verified Checkbox -->
                        <DataGridCheckBoxColumn
                            Header="Verified"
                            Binding="{Binding Verified, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="100">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- Delete Button -->
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Delete this author"
                                            Click="DeleteAuthor_Click">
                                        <materialDesign:PackIcon Kind="Delete"
                                                               Width="20"
                                                               Height="20"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <Grid x:Name="LoadingOverlay"
                      Background="#CC000000"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    Value="0"
                                    IsIndeterminate="True"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,0,16"/>
                        <TextBlock x:Name="LoadingText"
                                  Text="Loading authors from SVN..."
                                  Foreground="White"
                                  FontSize="14"
                                  TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Bottom Actions -->
        <materialDesign:Card Grid.Row="3" Margin="0,16,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Information"
                                            Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Margin="0,0,8,0"/>
                    <TextBlock Text="Double-click any cell to edit. Changes are saved automatically."
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Save & Close Buttons -->
                <Button x:Name="ExportButton"
                        Grid.Column="2"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Export to File"
                        Margin="0,0,8,0"
                        Click="Export_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Export authors.txt for git-svn"/>
                    </Button.ToolTip>
                </Button>

                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Save &amp; Close"
                        Click="Save_Click"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
