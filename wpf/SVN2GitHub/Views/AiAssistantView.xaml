<UserControl x:Class="SVN2GitHub.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="360">
    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,12"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34"
                        Height="34"
                        CornerRadius="11"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}">
                    <materialDesign:PackIcon Kind="RobotOutline"
                                             Width="19"
                                             Height="19"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Migration copilot"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProviderName}"
                               FontSize="11"
                               Opacity="0.62"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding NewChatCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="New chat">
                    <materialDesign:PackIcon Kind="Plus"
                                             Width="19"
                                             Height="19"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Conversations}"
                      SelectedItem="{Binding SelectedConversation}"
                      DisplayMemberPath="Title"
                      MinHeight="36"
                      materialDesign:HintAssist.Hint="Chat history"/>
            <Button Grid.Column="1"
                    Command="{Binding DeleteCurrentChatCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Margin="4,0,0,0"
                    ToolTip="Delete selected chat">
                <materialDesign:PackIcon Kind="DeleteOutline"
                                         Width="19"
                                         Height="19"/>
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding CloseAssistantCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Close chat panel">
                <materialDesign:PackIcon Kind="Close"
                                         Width="19"
                                         Height="19"/>
            </Button>
        </Grid>

        <ScrollViewer x:Name="ConversationScrollViewer"
                      Grid.Row="2"
                      Margin="12,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="Background" Value="#DDE2F3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="RobotOutline"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Kind" Value="AccountOutline"/>
                                                        <Setter Property="Foreground" Value="#35406A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Border>
                                <Border Grid.Column="1"
                                        Margin="7,0,0,0"
                                        Padding="10,8"
                                        MaxWidth="330"
                                        CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="Background" Value="#E9ECF7"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Assistant"/>
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Text" Value="You"/>
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="No reply received. Review the error below and send again."
                                                   TextWrapping="Wrap"
                                                   Foreground="#B3261E"
                                                   FontSize="11"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="18"
                            MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="MessageTextOutline"
                                             Width="30"
                                             Height="30"
                                             Opacity="0.55"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Ask anything about your migration"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,12,0,4"/>
                    <TextBlock Text="Your previous chats are saved locally and can be reopened from chat history."
                               FontSize="12"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="12,7"
                Background="{DynamicResource MaterialDesign.Brush.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.72">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.72"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B3261E"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Column="1"
                             Width="50"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="12,9,12,12">
            <Expander Header="Guided tasks and recovery advice" Margin="0,0,0,7">
                <StackPanel Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Content="Diagnose" Command="{Binding DraftGuidedTaskCommand}" CommandParameter="diagnose"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="32" Padding="10,0"/>
                        <Button Content="Recovery" Command="{Binding DraftGuidedTaskCommand}" CommandParameter="recover"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="32" Padding="10,0"/>
                        <Button Content="Readiness" Command="{Binding DraftGuidedTaskCommand}" CommandParameter="readiness"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="32" Padding="10,0"/>
                        <Button Content="Handover" Command="{Binding DraftGuidedTaskCommand}" CommandParameter="handover"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="32" Padding="10,0"/>
                    </WrapPanel>
                    <TextBlock Text="Local guidance (not generated by AI)" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,4"/>
                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding LocalGuidance}" TextWrapping="Wrap" FontSize="12"/>
                    </ScrollViewer>
                    <Button Content="Refresh migration snapshot" Command="{Binding RefreshMigrationContextCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Height="32" Margin="0,6,0,0"/>
                    <TextBlock Text="Drafts and refresh stay local. Review shared context and press Send to call AI."
                               FontSize="11" TextWrapping="Wrap" Opacity="0.65" Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>
            <Expander Margin="0,0,0,7">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ContextTitle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="  -  View shared context"
                                   FontSize="11"
                                   Opacity="0.62"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="0,7,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0"
                              Content="Include recent logs (redacted)"
                              IsChecked="{Binding IncludeLogs}"
                              Visibility="{Binding IsMigrationContext, Converter={StaticResource BooleanToVisibilityConverter}}"
                              FontSize="11"
                              Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding SharedContextPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="10"/>
                </Grid>
            </Expander>
            <materialDesign:Card Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="58"
                             MaxHeight="110"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8"
                             BorderThickness="0"
                             PreviewKeyDown="Question_PreviewKeyDown"
                             materialDesign:HintAssist.Hint="Ask a question..."/>
                    <Button Grid.Column="1"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Bottom"
                            ToolTip="Send (Enter)">
                        <materialDesign:PackIcon Kind="ArrowUp"
                                                 Width="21"
                                                 Height="21"/>
                    </Button>
                </Grid>
            </materialDesign:Card>
            <TextBlock Text="Enter to send  |  Shift+Enter for a new line"
                       FontSize="10"
                       Opacity="0.55"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
