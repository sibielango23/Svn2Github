<UserControl x:Class="SVN2GitHub.Views.NewMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="New Migration"
                      Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                      Margin="0,0,0,24"/>

            <!-- Form -->
            <StackPanel Grid.Row="1" MaxWidth="800" HorizontalAlignment="Left">

                <!-- SVN Configuration Card -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="SVN Configuration"
                                  Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                  Margin="0,0,0,16"/>

                        <TextBox materialDesign:HintAssist.Hint="SVN Repository URL"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding SvnUrl, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Trunk Path"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding TrunkPath, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Branches Path"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding BranchesPath, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Column="4"
                                    materialDesign:HintAssist.Hint="Tags Path"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding TagsPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- GitHub Configuration Card -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="GitHub Configuration"
                                  Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                  Margin="0,0,0,16"/>

                        <TextBox materialDesign:HintAssist.Hint="GitHub Organization"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding GithubOrg, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"/>

                        <TextBox materialDesign:HintAssist.Hint="GitHub Repository Name"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding GithubRepo, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"/>

                        <PasswordBox materialDesign:HintAssist.Hint="GitHub Personal Access Token"
                                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                    x:Name="TokenPasswordBox"
                                    PasswordChanged="TokenPasswordBox_PasswordChanged"
                                    Margin="0,0,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Options Card -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Migration Options"
                                  Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                  Margin="0,0,0,16"/>

                        <CheckBox Content="Clean repository history (remove large binaries and build artifacts)"
                                 IsChecked="{Binding CleanHistory}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Text="⚠️ Warning: History cleaning will rewrite all commits. This process is irreversible."
                                  Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                  Foreground="{DynamicResource SecondaryHueMidBrush}"
                                  TextWrapping="Wrap"
                                  Margin="32,0,0,16"/>

                        <!-- Author Mapping Button -->
                        <Border Background="{DynamicResource MaterialDesignDivider}"
                                Padding="16"
                                CornerRadius="4"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0"
                                                        Kind="AccountEdit"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Author Mapping"
                                              FontWeight="Medium"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="Map SVN usernames to Git author names and emails"
                                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                       x:Name="ConfigureAuthorsButton"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Content="Configure"
                                       Click="ConfigureAuthors_Click"
                                       ToolTip="Open author mapping editor"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                           Content="CLEAR"
                           Command="{Binding ClearFormCommand}"
                           Margin="0,0,16,0"
                           Width="120"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                           Content="START MIGRATION"
                           Command="{Binding StartMigrationAsyncCommand}"
                           Width="180"/>
                </StackPanel>

                <!-- Loading Indicator -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsSubmitting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
