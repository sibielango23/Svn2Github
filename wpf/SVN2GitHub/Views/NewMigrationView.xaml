<UserControl x:Class="SVN2GitHub.Views.NewMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24,24" MaxWidth="900" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Move your repository"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <TextBlock Text="A guided setup keeps the source, destination, and final review easy to follow."
                           Opacity="0.68"
                           Margin="0,6,12,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Start over"
                    Click="ClearForm_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="17">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="1"
                               Foreground="White"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Source" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="SVN repository" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1"
                    Height="1"
                    Background="{DynamicResource MaterialDesignDivider}"
                    VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="17">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="2"
                               Foreground="White"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Destination" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="GitHub repository" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="3"
                    Height="1"
                    Background="{DynamicResource MaterialDesignDivider}"
                    VerticalAlignment="Center"/>
            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="17">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="3"
                               Foreground="White"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Review" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Options &amp; authors" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <materialDesign:Card Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,22">
                            <TextBlock Text="{Binding CurrentStep, StringFormat=Step {0} of 3}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Connect your SVN source"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Text" Value="Choose your GitHub destination"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Text" Value="Review before you migrate"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap"
                                       Opacity="0.68"
                                       Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Enter the root URL of the SVN repository you want to move."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Text" Value="Select the GitHub owner and repository where the converted history will be pushed."/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Text" Value="Check the details, author identities, and optional history-cleaning setting."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBox Text="{Binding SvnUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="SVN repository URL"
                                         Margin="0,0,0,8"/>
                                <TextBlock Text="Example: https://svn.example.com/project"
                                           FontSize="12"
                                           Opacity="0.62"
                                           Margin="4,0,0,18"/>

                                <materialDesign:Card Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Repository layout"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Most repositories use these defaults. Change them only if your SVN layout is different."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.65"
                                                   Margin="0,4,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding TrunkPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     materialDesign:HintAssist.Hint="Trunk path"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding BranchesPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     materialDesign:HintAssist.Hint="Branches path"/>
                                            <TextBox Grid.Column="4"
                                                     Text="{Binding TagsPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     materialDesign:HintAssist.Hint="Tags path"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding GithubOrg, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="GitHub owner or organization"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding GithubRepo, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="New repository name"/>
                                </Grid>
                                <Border Background="{DynamicResource MaterialDesign.Brush.Surface}"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,18,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="InformationOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,12,0"
                                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="The app reuses an accessible existing GitHub repository or creates a private one if absent. Existing settings are preserved. Normal pushes never force-overwrite divergent history; use an empty destination for your first test."
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <PasswordBox x:Name="TokenPasswordBox"
                                             PasswordChanged="TokenPasswordBox_PasswordChanged"
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             materialDesign:HintAssist.Hint="GitHub personal access token"/>
                                <TextBlock Text="The token is kept in memory for the migration and is not saved in migration history."
                                           FontSize="12"
                                           Opacity="0.62"
                                           Margin="4,8,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="Check local readiness before starting"
                                        Command="{Binding CheckReadinessCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                <Button Content="Assess SVN and GitHub (read-only)"
                                        Command="{Binding AssessMigrationCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:Card Grid.Column="0" Padding="16" Margin="0,0,7,0">
                                        <StackPanel>
                                            <TextBlock Text="SVN source"
                                                       FontSize="12"
                                                       Opacity="0.62"/>
                                            <TextBlock Text="{Binding SvnUrl}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>
                                    <materialDesign:Card Grid.Column="1" Padding="16" Margin="7,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="GitHub destination"
                                                       FontSize="12"
                                                       Opacity="0.62"/>
                                            <TextBlock FontWeight="SemiBold" Margin="0,6,0,0">
                                                <Run Text="{Binding GithubOrg}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding GithubRepo}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </Grid>

                                <materialDesign:Card Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Author identities"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AuthorMappingSummary}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Opacity="0.68"
                                                       Margin="0,4,14,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Review authors"
                                                Click="ConfigureAuthors_Click"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </materialDesign:Card>

                                <CheckBox IsChecked="{Binding CleanHistory}"
                                          FontWeight="SemiBold"
                                          Content="Remove large binaries and common build artifacts"
                                          Margin="2,0,0,6"/>
                                <TextBlock Text="This optional cleanup rewrites Git history and changes commit IDs. Use it only when you intend to remove these files from every revision."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Opacity="0.68"
                                           Margin="25,0,0,12"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,18,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap"
                       Foreground="#B3261E"
                       Margin="0,0,0,8"/>
            <Button Grid.Row="1" Grid.Column="0"
                    Content="Back"
                    Command="{Binding PreviousStepCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="120"
                    Height="44"
                    Padding="16,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
            <Button Grid.Row="1" Grid.Column="1"
                    MinWidth="160"
                    Height="44"
                    Padding="16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Content" Value="Next"/>
                        <Setter Property="Command" Value="{Binding NextStepCommand}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                <Setter Property="Content" Value="Start migration"/>
                                <Setter Property="Command" Value="{Binding StartMigrationCommand}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
