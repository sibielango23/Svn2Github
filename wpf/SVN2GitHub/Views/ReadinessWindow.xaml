<Window x:Class="SVN2GitHub.Views.ReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Local migration readiness" Width="720" Height="660" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Check before you migrate" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,8"/>
            <TextBlock Text="{Binding Report.CheckedAt, StringFormat=Checked at {0}}" FontSize="11" Opacity="0.65"/>
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Report.Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,8,10" CornerRadius="8" Background="{DynamicResource MaterialDesign.Brush.Surface}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" Margin="0,4,0,4" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                                    <Setter Property="Foreground" Value="#B3261E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="warning">
                                                    <Setter Property="Foreground" Value="#986000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Export report" Command="{Binding ExportReportCommand}" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Copy report" Command="{Binding CopyReportCommand}" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Check again" Command="{Binding RefreshCommand}" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Close" IsCancel="True" Height="40" Style="{StaticResource MaterialDesignFlatButton}"/>
        </WrapPanel>
    </Grid>
</Window>
